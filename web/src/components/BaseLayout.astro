---
import {Image} from 'astro:assets'
import '../styles/global.css'
import {localizedPath, siteCopy, type Locale} from '../lib/locales'
import {absoluteUrl, localeTag, serializeJsonLd, siteOrigin} from '../lib/seo'

interface Props {
  locale: Locale
  title: string
  description: string
  languageLinks?: Partial<Record<Locale, string>>
  alternatePaths?: Partial<Record<Locale, string>>
  canonicalPath?: string
  ogType?: 'website' | 'article'
  structuredData?: Array<Record<string, unknown>>
}

const {locale, title, description, languageLinks = {}, alternatePaths, canonicalPath, ogType = 'website', structuredData = []} = Astro.props
const copy = siteCopy[locale]
const homeHref = localizedPath(locale)
const spanishHref = languageLinks.es ?? localizedPath('es')
const englishHref = languageLinks.en ?? localizedPath('en')
const canonicalUrl = absoluteUrl(canonicalPath ?? homeHref)
const alternateLinks = [
  {locale: 'es' as const, path: alternatePaths?.es ?? localizedPath('es')},
  {locale: 'en' as const, path: alternatePaths?.en ?? localizedPath('en')},
]
  .map(({locale: alternateLocale, path}) => ({locale: alternateLocale, url: absoluteUrl(path)}))
  .filter((alternate): alternate is {locale: Locale; url: string} => Boolean(alternate.url))
const siteSchemas = siteOrigin && canonicalUrl ? [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${siteOrigin}/#person`,
    name: 'Guillermo Anta Alonso',
    jobTitle: 'Senior Backend Engineer / Tech Lead',
    url: siteOrigin,
    sameAs: ['https://www.linkedin.com/in/guillermoanta/'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteOrigin}/#website`,
    name: 'Guillermo Anta Alonso',
    url: siteOrigin,
    inLanguage: locale,
  },
] : []
const schemas = [...siteSchemas, ...structuredData]
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline>
      try {
        const storedTheme = localStorage.getItem('portfolio-theme')
        if (storedTheme === 'light' || storedTheme === 'dark') {
          document.documentElement.dataset.theme = storedTheme
        }
      } catch {}
    </script>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/gaa-favicon-final.png" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {alternateLinks.map((alternate) => <link rel="alternate" hreflang={alternate.locale} href={alternate.url} />)}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Guillermo Anta Alonso" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={localeTag(locale)} />
    <meta property="og:locale:alternate" content={locale === 'es' ? 'en_US' : 'es_ES'} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {schemas.map((schema) => <script type="application/ld+json" set:html={serializeJsonLd(schema)} />)}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">{copy.skipToContent}</a>

    <header class="topbar">
      <div class="shell topbar-inner">
        <a class="wordmark" href={homeHref} aria-label="Guillermo Anta Alonso">
          <Image class="wordmark-image" src="/gaa-header-final.png" alt="" aria-hidden="true" width={1160} height={420} />
        </a>
        <div class="header-controls">
          <nav class="nav-links" aria-label={copy.navigationLabel}>
            <a href={`${homeHref}#inicio`}>{copy.homeLabel}</a>
            <a href={`${homeHref}#experiencia`}>{copy.experienceLabel}</a>
            <a href={`${homeHref}#proyecto`}>{copy.projectsLabel}</a>
            <a href={localizedPath(locale, 'blog')}>{copy.blogLabel}</a>
            <a href={`${homeHref}#contacto`}>{copy.contactLabel}</a>
          </nav>
          <div class="utility-group">
            <nav class="language-switch" aria-label={copy.languageLabel}>
              <a href={spanishHref} lang="es" aria-current={locale === 'es' ? 'page' : undefined}>ES</a>
              <a href={englishHref} lang="en" aria-current={locale === 'en' ? 'page' : undefined}>EN</a>
            </nav>
            <button
              class="theme-toggle"
              type="button"
              data-theme-toggle
              data-to-light={copy.theme.toLight}
              data-to-dark={copy.theme.toDark}
              aria-label={copy.theme.toLight}
              title={copy.theme.toLight}
            >
              <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
              </svg>
              <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M20.5 14.1A8.5 8.5 0 0 1 9.9 3.5 8.5 8.5 0 1 0 20.5 14.1Z"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <span>Guillermo Anta Alonso</span>
        <nav class="footer-social" aria-label={copy.social.label}>
          <a class="footer-social-link" href="https://www.linkedin.com/in/guillermoanta/" target="_blank" rel="noreferrer">
            <svg class="footer-social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V8.99h3.41v1.56h.05c.47-.9 1.63-1.85 3.35-1.85 3.59 0 4.25 2.36 4.25 5.43v6.32ZM5.32 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14ZM3.55 20.45h3.56V8.99H3.55v11.46ZM22.23 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.72V1.72C24 .77 23.21 0 22.23 0Z"></path>
            </svg>
            <span>{copy.social.linkedin}</span>
          </a>
          <a class="footer-social-link" href="https://github.com/Antazx" target="_blank" rel="noreferrer">
            <svg class="footer-social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.084-.729.084-.729 1.205.084 1.84 1.237 1.84 1.237 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23a11.5 11.5 0 0 1 3.003-.404c1.018.005 2.043.138 3.003.404 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path>
            </svg>
            <span>{copy.social.github}</span>
          </a>
        </nav>
        <a class="footer-newsletter-link" href={`${localizedPath(locale, 'blog')}#newsletter`}>{copy.newsletterLabel}</a>
        <span>{copy.footerRole}</span>
      </div>
    </footer>

    <script is:inline>
      const root = document.documentElement
      const themeToggle = document.querySelector('[data-theme-toggle]')
      const updateThemeControl = () => {
        if (!themeToggle) return
        const label = root.dataset.theme === 'dark' ? themeToggle.dataset.toLight : themeToggle.dataset.toDark
        if (label) {
          themeToggle.setAttribute('aria-label', label)
          themeToggle.setAttribute('title', label)
        }
      }

      updateThemeControl()

      themeToggle?.addEventListener('click', () => {
        const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark'
        root.dataset.theme = nextTheme
        try {
          localStorage.setItem('portfolio-theme', nextTheme)
        } catch {}
        updateThemeControl()
      })
    </script>
  </body>
</html>
