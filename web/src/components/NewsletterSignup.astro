---
import {localizedPath, type Locale} from '../lib/locales'
import {legalPaths} from '../lib/legal'
import {newsletterSignupConfig} from '../lib/newsletter'

interface Props {
  locale: Locale
}

const {locale} = Astro.props
const config = newsletterSignupConfig(locale)
const copy = {
  es: {
    eyebrow: 'Newsletter',
    heading: 'Recibe las nuevas publicaciones',
    intro: 'Una selección de notas sobre ingeniería de software, arquitectura y trabajo con IA.',
    emailLabel: 'Correo electrónico',
    emailHelp: 'Usaremos este correo únicamente para la newsletter del portfolio.',
    consent: 'Acepto recibir la newsletter del portfolio.',
    consentHelp: 'Después de enviar el formulario tendrás que confirmar tu dirección por correo.',
    submit: 'Solicitar suscripción',
    unavailable: 'La suscripción está temporalmente desactivada mientras terminamos de validar Brevo.',
    pendingLink: 'Ya he enviado el formulario',
    confirmationLink: 'Ir a la confirmación',
    privacyLink: 'Política de privacidad',
    submitError: 'No hemos podido tramitar tu suscripción. Inténtalo de nuevo.',
    networkError: 'No hemos podido confirmar el resultado. Revisa tu correo antes de reintentarlo.',
  },
  en: {
    eyebrow: 'Newsletter',
    heading: 'Get new publications',
    intro: 'A selection of notes about software engineering, architecture and AI-assisted work.',
    emailLabel: 'Email address',
    emailHelp: 'We will use this address only for the portfolio newsletter.',
    consent: 'I agree to receive the portfolio newsletter.',
    consentHelp: 'After submitting the form, you will need to confirm your address by email.',
    submit: 'Request subscription',
    unavailable: 'Subscription is temporarily disabled while we finish validating Brevo.',
    pendingLink: 'I have already submitted the form',
    confirmationLink: 'Go to confirmation',
    privacyLink: 'Privacy policy',
    submitError: 'We could not process your subscription. Please try again.',
    networkError: 'We could not confirm the result. Check your inbox before trying again.',
  },
}[locale]
const emailId = `newsletter-email-${locale}`
const consentId = `newsletter-consent-${locale}`
const formId = `newsletter-form-${locale}`
// Brevo's generated form maps category choices ES/EN to submitted values 1/2.
const brevoLanguageValue = locale === 'es' ? '1' : '2'
---

<section class="shell newsletter-section" id="newsletter" aria-labelledby={`newsletter-title-${locale}`}>
  <div class="section-heading">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id={`newsletter-title-${locale}`}>{copy.heading}</h2>
    <p class="section-intro">{copy.intro}</p>
  </div>

  {config.enabled ? (
    <form
      id={formId}
      class="newsletter-form"
      action={config.formUrl}
      method="post"
      data-newsletter-form
      data-pending-url={localizedPath(locale, 'newsletter/pendiente')}
      data-submit-error={copy.submitError}
      data-network-error={copy.networkError}
    >
      <div class="form-field">
        <label for={emailId}>{copy.emailLabel}</label>
        <input id={emailId} name="EMAIL" type="email" autocomplete="email" maxlength="254" required aria-describedby={`${emailId}-help`} />
        <p id={`${emailId}-help`} class="form-help">{copy.emailHelp}</p>
      </div>

      <input type="hidden" name="PORTFOLIO_LANGUAGE" value={brevoLanguageValue} />

      <div class="form-field newsletter-consent">
        <label for={consentId}>
          <input id={consentId} name="OPT_IN" type="checkbox" value="1" required aria-describedby={`${consentId}-help`} />
          <span>{copy.consent}</span>
        </label>
        <p id={`${consentId}-help`} class="form-help">{copy.consentHelp}</p>
      </div>

      <p class="form-help"><a href={legalPaths[locale].privacy}>{copy.privacyLink}</a></p>
      <button class="button" type="submit">{copy.submit}</button>
      <p class="newsletter-form-error" data-newsletter-status role="alert" tabindex="-1" hidden></p>
      <p class="newsletter-status-links">
        <a href={localizedPath(locale, 'newsletter/pendiente')}>{copy.pendingLink}</a>
        <a href={localizedPath(locale, 'newsletter/confirmacion')}>{copy.confirmationLink}</a>
      </p>
    </form>
  ) : (
    <div class="newsletter-unavailable" role="status" aria-live="polite">
      <p>{copy.unavailable}</p>
      <p><a href={legalPaths[locale].privacy}>{copy.privacyLink}</a></p>
    </div>
  )}
</section>

<script is:inline>
  const form = document.querySelector('[data-newsletter-form]')

  if (form instanceof HTMLFormElement) {
    const submit = form.querySelector('button[type="submit"]')
    const status = form.querySelector('[data-newsletter-status]')

    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      if (!(submit instanceof HTMLButtonElement) || !(status instanceof HTMLElement)) return

      submit.disabled = true
      form.setAttribute('aria-busy', 'true')
      status.hidden = true
      status.textContent = ''

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: {
            accept: 'application/json',
            'content-type': 'application/x-www-form-urlencoded',
          },
          body: new URLSearchParams(new FormData(form)),
        })
        const result = await response.json()

        if (response.ok && result?.success === true) {
          window.location.assign(form.dataset.pendingUrl)
          return
        }

        const detail = result?.errors && typeof result.errors === 'object'
          ? Object.values(result.errors).find((message) => typeof message === 'string')
          : undefined
        status.textContent = [form.dataset.submitError, detail].filter(Boolean).join(' ')
      } catch {
        status.textContent = form.dataset.networkError ?? ''
      } finally {
        submit.disabled = false
        form.removeAttribute('aria-busy')
      }

      status.hidden = false
      status.focus()
    })
  }
</script>
