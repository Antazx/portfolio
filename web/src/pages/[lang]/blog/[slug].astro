---
import {PortableText} from 'astro-portabletext'
import BaseLayout from '../../../components/BaseLayout.astro'
import PortableTextImage from '../../../components/PortableTextImage.astro'
import {locales, localizedPath, type Locale} from '../../../lib/locales'
import {postQuery, postSlugsQuery, sanityClient} from '../../../lib/sanity'
import {absoluteUrl, siteOrigin} from '../../../lib/seo'

export async function getStaticPaths() {
  const paths = await Promise.all(
    locales.map(async (locale) => {
      const posts = await sanityClient.fetch(postSlugsQuery, {locale})
      return posts.map((post) => ({params: {lang: locale, slug: post.slug}, props: {locale}}))
    }),
  )

  return paths.flat()
}

const locale = Astro.props.locale as Locale
const {slug} = Astro.params
const post = await sanityClient.fetch(postQuery, {locale, slug})

if (!post) {
  throw new Error(`Publication not found: ${locale}/${slug}`)
}

const copy = {
  es: {
    description: 'Publicación del blog de Guillermo Anta Alonso.',
    back: 'Volver al blog',
    language: 'Idioma de la publicación',
  },
  en: {
    description: 'Blog publication by Guillermo Anta Alonso.',
    back: 'Back to blog',
    language: 'Publication language',
  },
}[locale]
const postPath = `/${locale}/blog/${post.slug}/`
const postUrl = absoluteUrl(postPath)
const structuredData = postUrl && siteOrigin ? [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.title,
    description: post.excerpt,
    url: postUrl,
    mainEntityOfPage: postUrl,
    datePublished: post.publishedAt,
    dateModified: post.publishedAt,
    inLanguage: locale,
    author: {'@id': `${siteOrigin}/#person`},
    isPartOf: {'@id': `${siteOrigin}/#website`},
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Portfolio', item: absoluteUrl(`/${locale}/`) },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: absoluteUrl(`/${locale}/blog/`) },
      { '@type': 'ListItem', position: 3, name: post.title, item: postUrl },
    ],
  },
] : []
---

<BaseLayout
  locale={locale}
  title={`${post.title} — Guillermo Anta Alonso`}
  description={copy.description}
  languageLinks={{
    es: post.hasSpanish ? `/es/blog/${post.slug}/` : localizedPath('es'),
    en: post.hasEnglish ? `/en/blog/${post.slug}/` : localizedPath('en'),
  }}
  alternatePaths={{
    es: post.hasSpanish ? `/es/blog/${post.slug}/` : undefined,
    en: post.hasEnglish ? `/en/blog/${post.slug}/` : undefined,
  }}
  canonicalPath={postPath}
  ogType="article"
  structuredData={structuredData}
>
  <article class="shell post-detail">
    <header class="post-header">
      <a class="back-link" href={localizedPath(locale, 'blog')}>← {copy.back}</a>
      <p class="experience-date">{post.publishedAt && new Date(post.publishedAt).toLocaleDateString(locale === 'es' ? 'es-ES' : 'en-US', {dateStyle: 'long'})}</p>
      <h1>{post.title}</h1>
      <p class="post-excerpt">{post.excerpt}</p>
      <nav class="post-language" aria-label={copy.language}>
        {post.hasSpanish && <a href={`/es/blog/${post.slug}/`} lang="es" aria-current={locale === 'es' ? 'page' : undefined}>ES</a>}
        {post.hasEnglish && <a href={`/en/blog/${post.slug}/`} lang="en" aria-current={locale === 'en' ? 'page' : undefined}>EN</a>}
      </nav>
    </header>
    <div class="portable-text">
      {post.body && <PortableText value={post.body} components={{type: {articleImage: PortableTextImage}}} />}
    </div>
  </article>
</BaseLayout>
