---
import {Image} from 'astro:assets'
import BaseLayout from '../../components/BaseLayout.astro'
import ContactForm from '../../components/ContactForm.astro'
import {cvAsset} from '../../lib/cv'
import {locales, type Locale} from '../../lib/locales'
import {portfolio} from '../../lib/portfolio'

export function getStaticPaths() {
  return locales.map((locale) => ({params: {lang: locale}, props: {locale}}))
}

const locale = Astro.props.locale as Locale
const content = portfolio[locale]
const cv = cvAsset(locale)
---

<BaseLayout locale={locale} title={content.title} description={content.description}>
  <section class="shell hero" id="inicio" aria-labelledby="hero-title">
    <div class="hero-copy-block">
      <p class="eyebrow">{content.eyebrow}</p>
      <h1 id="hero-title">Guillermo Anta Alonso</h1>
      <p class="hero-role">{content.role}</p>
      <p class="hero-copy">{content.intro}</p>
      <div class="hero-actions">
        <a class="button" href="#experiencia">{content.primaryAction}</a>
        <a class="button secondary" href="#contacto">{content.secondaryAction}</a>
        <a class="button secondary" href={cv.href} download={cv.filename}>{content.downloadCvLabel}</a>
      </div>
    </div>
    <aside class="hero-meta" aria-label={locale === 'es' ? 'Resumen profesional' : 'Professional summary'}>
      {content.summary.map((item, index) => (
        <div class="meta-row">
          <span>{item.label}</span>
          {index === content.summary.length - 1 ? (
            <span class="meta-links">
              <a
                href="https://www.linkedin.com/in/guillermoanta/"
                target="_blank"
                rel="noreferrer"
                aria-label={content.contact.linkedinAriaLabel}
              >
                {item.value}
              </a>
              <span aria-hidden="true">·</span>
              <a href="#contacto" aria-label={locale === 'es' ? 'Formulario de contacto' : 'Contact form'}>
                {content.contact.emailFieldLabel}
              </a>
            </span>
          ) : <strong>{item.value}</strong>}
        </div>
      ))}
    </aside>
  </section>

  <section class="section" id="experiencia" aria-labelledby="experience-title">
    <div class="shell">
      <div class="section-heading">
        <h2 id="experience-title">{content.experience.title}</h2>
        <p class="section-intro">{content.experience.intro}</p>
      </div>
      <div class="experience-list">
        {content.experience.items.map((item) => (
          <article class="experience-item">
            <div class="experience-date">{item.period}</div>
            <div>
              <h3>{item.company} <span class="experience-company">— {item.role}</span></h3>
              <ul>
                {item.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="estudios" aria-labelledby="education-title">
    <div class="shell">
      <div class="section-heading">
        <h2 id="education-title">{content.education.title}</h2>
        <p class="section-intro">{content.education.intro}</p>
      </div>
      <div class="experience-list">
        <article class="experience-item">
          <div class="experience-date">{content.education.label}</div>
          <div>
            <h3>{content.education.degree}</h3>
            <p class="experience-company">{content.education.specialization}</p>
            <p class="section-intro">{content.education.institution}</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="proyecto" aria-labelledby="projects-title">
    <div class="shell">
      <div class="section-heading">
        <h2 id="projects-title">{content.projects.title}</h2>
        <p class="section-intro">{content.projects.intro}</p>
      </div>
      <div class="project-list">
        {content.projects.items.map((project) => (
          <article class="experience-item project-item">
            <div class="experience-date">{project.label}</div>
            <div>
              <h3>
                {project.name} <span class="experience-company">— {project.role}</span>
                {project.status && <span class="project-status">{project.status}</span>}
              </h3>
              <p class="project-copy">{project.description}</p>
              <ul>
                {project.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
              <a
                class="button secondary project-link"
                href={project.link}
                target={project.link.startsWith('http') ? '_blank' : undefined}
                rel={project.link.startsWith('http') ? 'noreferrer' : undefined}
              >
                {project.link.startsWith('http') && <Image class="project-link-icon" src="/favicon-ring.png" alt="" aria-hidden="true" width={20} height={20} />}
                {project.linkLabel}
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="contacto" aria-labelledby="contact-title">
    <div class="shell contact-layout">
      <div class="contact-copy-block">
        <h2 class="contact-title" id="contact-title">{content.contact.title}</h2>
        <p class="experience-date">{content.contact.label}</p>
        <p class="contact-copy">{content.contact.intro}</p>
      </div>
      <div class="contact-links" aria-label={content.contact.label}>
        <span class="contact-email">{content.contact.emailLabel}</span>
      </div>
      <ContactForm locale={locale} copy={content.contact} />
    </div>
  </section>
</BaseLayout>
