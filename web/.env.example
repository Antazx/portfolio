# Sanity: fill after creating the project and dataset.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Public canonical origin, for example https://portfolio.example.com.
PUBLIC_SITE_URL=

# Brevo portfolio integration. Both flows are disabled until their independent
# validation gates are approved. Keep credentials and provider IDs out of Git.
PORTFOLIO_NEWSLETTER_MODE=off
PORTFOLIO_NEWSLETTER_SIGNUP_ENABLED=false
PORTFOLIO_CONTACT_MODE=off

# Newsletter resources: separate credentials and audiences for test/production.
PORTFOLIO_BREVO_NEWSLETTER_API_KEY=
PORTFOLIO_BREVO_NEWSLETTER_LIST_ID=
PORTFOLIO_BREVO_NEWSLETTER_TEST_LIST_ID=
PORTFOLIO_BREVO_NEWSLETTER_SEGMENT_ID=
PORTFOLIO_BREVO_NEWSLETTER_TEST_SEGMENT_ID=
PORTFOLIO_BREVO_NEWSLETTER_SENDER_EMAIL=
PORTFOLIO_BREVO_NEWSLETTER_SENDER_NAME=
PORTFOLIO_NEWSLETTER_REPLY_TO=
PORTFOLIO_NEWSLETTER_ALERT_TO=
PORTFOLIO_NEWSLETTER_FORM_URL_ES=
PORTFOLIO_NEWSLETTER_FORM_URL_EN=
PORTFOLIO_SANITY_NEWSLETTER_WEBHOOK_SECRET=

# Contact resources: no marketing list/contact mutation is allowed.
PORTFOLIO_BREVO_CONTACT_API_KEY=
PORTFOLIO_BREVO_CONTACT_SENDER_EMAIL=
PORTFOLIO_BREVO_CONTACT_SENDER_NAME=
# Confirmed portfolio destination; configure it only in the target environment.
PORTFOLIO_CONTACT_TO=
PORTFOLIO_CONTACT_TEST_TO=
