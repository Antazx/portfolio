{
  "name": "portfolio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "pnpm --filter portfolio-web dev",
    "dev:studio": "pnpm --filter portfolio-studio dev",
    "build": "pnpm --filter portfolio-web build",
    "build:studio": "pnpm --filter portfolio-studio build",
    "audit:a11y": "pnpm --filter portfolio-web audit:a11y",
    "verify:production": "pnpm --filter portfolio-web verify:production",
    "preview": "pnpm --filter portfolio-web preview",
    "typegen": "pnpm --filter portfolio-studio typegen",
    "test:newsletter": "node --experimental-strip-types --test netlify/functions/newsletter/*.test.ts",
    "test:newsletter-gate": "node --test scripts/check-newsletter-gate.test.mjs scripts/verify-newsletter-public.test.mjs",
    "check:newsletter-gate": "node scripts/check-newsletter-gate.mjs",
    "verify:newsletter:public": "node scripts/verify-newsletter-public.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.1"
  }
}
